# Copy to .env, or run `make setup` to generate one with random values.
# Use letters and digits only for the password: it is placed inside a database URL.
POSTGRES_PASSWORD=
CAE_SECRET_KEY=

# Address and port the app listens on. Keep 127.0.0.1 unless it sits behind a TLS reverse proxy.
CAE_BIND=127.0.0.1
CAE_PORT=8080
