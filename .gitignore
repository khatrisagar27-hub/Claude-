# ---- Secrets & local config ----
# .env.example IS committed as the template; real .env files never are.
.env
.env.*
!.env.example

# ---- Runtime data ----
# CAE writes ingested files here; they are client data, not source.
cae/backend/uploads/
uploads/
*.log

# ---- Excel lock / recovery files ----
# The workbooks themselves (LexComply_India.xlsm,
# Foreign_Gain_Loss_Workbook.xlsx) are committed deliverables — only
# Excel's temporary artefacts are ignored.
~$*
*.xlk

# ---- Editors & OS ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
