# ---- Python (cae/backend) ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
*.egg-info/
*.egg
.installed.cfg

# Virtual environments
.venv/
venv/
ENV/
env/

# Test & coverage artefacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---- Node / frontend (cae/frontend) ----
node_modules/
cae/frontend/dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
